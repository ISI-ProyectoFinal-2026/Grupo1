// PATITAS - Esquema de base de datos (Backend Principal)
// Fuente de verdad del esquema: docs/ARQUITECTURA.md (sección 5).
// El servicio Backend IA (backend-ia/) lee y escribe sobre las mismas tablas
// `reports` y `report_embeddings`, pero NO gestiona migraciones: Prisma es la
// única fuente de migraciones para toda la base de datos.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, vector]
}

enum Role {
  usuario_regular
  moderador
  admin

  @@map("role")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String?  @map("full_name")
  phone        String?
  role         Role     @default(usuario_regular)
  // null = email sin verificar. No bloquea el login: solo las acciones que
  // exigen `requireVerifiedEmail` (ej. registrar un comercio).
  emailVerifiedAt DateTime? @map("email_verified_at")
  // Versión de sesión: viaja en el JWT como `tv`. Incrementarla invalida todos
  // los tokens emitidos antes (ej. al restablecer la contraseña).
  tokenVersion Int      @default(0) @map("token_version")
  // Segundo factor (TOTP). El secreto va cifrado; `twoFactorEnabledAt` null con
  // secreto presente = alta iniciada y sin confirmar. El contador y el bloqueo
  // viven en la base para que valgan con requests en paralelo y en todas las
  // instancias; el reinicio demorado se mide desde `twoFactorResetRequestedAt`.
  twoFactorSecretEnc        String?   @map("two_factor_secret_enc")
  twoFactorEnabledAt        DateTime? @map("two_factor_enabled_at")
  twoFactorLastStep         Int?      @map("two_factor_last_step")
  twoFactorFailedAttempts   Int       @default(0) @map("two_factor_failed_attempts")
  twoFactorLockedUntil      DateTime? @map("two_factor_locked_until")
  twoFactorResetRequestedAt DateTime? @map("two_factor_reset_requested_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  authTokens    AuthToken[]
  twoFactorRecoveryCodes TwoFactorRecoveryCode[]
  pets          Pet[]
  reports       Report[]
  notifications Notification[]
  notificationPreference NotificationPreference?
  messages      Message[]
  chatsAsUserA  Chat[]          @relation("ChatUserA")
  chatsAsUserB  Chat[]          @relation("ChatUserB")
  reportFlags   ReportFlag[]
  accountReportsMade     AccountReport[] @relation("AccountReportReporter")
  accountReportsReceived AccountReport[] @relation("AccountReportReported")
  accountSanctions       AccountSanction[]      @relation("SanctionTarget")
  accountSanctionEvents  AccountSanctionEvent[] @relation("SanctionActor")
  adFlags       AdFlag[]
  business      Business?
  businessEvents BusinessEvent[]
  roleChangesMade     RoleChangeAudit[] @relation("RoleChangeActor")
  roleChangesReceived RoleChangeAudit[] @relation("RoleChangeTarget")

  @@map("users")
}

enum AuthTokenType {
  email_verification
  password_reset
  two_factor_login
  two_factor_reset
  two_factor_reset_cancel

  @@map("auth_token_type")
}

// Tokens de un solo uso que viajan por mail (verificación de email y reset de
// contraseña). Solo se guarda el sha256 del token: quien lea la base no puede
// usarlos. `usedAt` marca tanto el consumo como la invalidación por reemisión.
model AuthToken {
  id        Int           @id @default(autoincrement())
  userId    Int           @map("user_id")
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

// Códigos de recuperación del segundo factor. Solo se guarda el sha256 del
// código normalizado; `usedAt` lo marca como gastado (un solo uso).
model TwoFactorRecoveryCode {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("two_factor_recovery_codes")
}

model Pet {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  name        String?
  species     String? // dog | cat | other
  breed       String?
  age         Int?
  color       String?
  description String?
  photoUrls   String[] @map("photo_urls")
  microchipId String?  @map("microchip_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports Report[]

  @@map("pets")
}

enum ReportType {
  lost
  found

  @@map("report_type")
}

enum ReportStatus {
  pending
  published
  rejected
  resolved

  @@map("report_status")
}

model Report {
  id              Int          @id @default(autoincrement())
  userId          Int          @map("user_id")
  petId           Int?         @map("pet_id")
  reportType      ReportType   @map("report_type")
  status          ReportStatus @default(pending)
  title           String
  description     String?
  imageUrl        String?      @map("image_url")
  customFlyerUrl  String?      @map("custom_flyer_url")
  // PostGIS point (lat/long). Prisma no modela tipos geométricos de forma
  // nativa: se declara como Unsupported y se maneja con SQL crudo cuando haga
  // falta (ST_DWithin, etc. — ver docs/ARQUITECTURA.md sección 4.3).
  location        Unsupported("geometry(Point, 4326)")?
  locationAddress String?      @map("location_address")
  // teléfono del autor en el flyer público, solo con consentimiento (#259)
  showPhoneOnFlyer Boolean     @default(false) @map("show_phone_on_flyer")
  // fecha del suceso (#259); null en reportes anteriores
  eventDate       DateTime?    @db.Date @map("event_date")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  publishedAt     DateTime?    @map("published_at")

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  pet    Pet?             @relation(fields: [petId], references: [id])
  embedding      ReportEmbedding?
  matchesAsLost  ReportMatch[]   @relation("MatchLost")
  matchesAsFound ReportMatch[]   @relation("MatchFound")
  chats          Chat[]
  notifications  Notification[]
  flags          ReportFlag[]

  @@index([status])
  @@index([reportType])
  @@map("reports")
}

enum ReportFlagStatus {
  pending
  reviewed // aceptada: el reporte se oculta
  dismissed // descartada: el reporte sigue publicado

  @@map("report_flag_status")
}

model ReportFlag {
  id        Int               @id @default(autoincrement())
  reportId  Int               @map("report_id")
  userId    Int               @map("user_id")
  reason    String
  status    ReportFlagStatus  @default(pending)
  createdAt DateTime          @default(now()) @map("created_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reportId, userId])
  @@index([status])
  @@index([reportId])
  @@map("report_flags")
}

model ReportEmbedding {
  id        Int      @id @default(autoincrement())
  reportId  Int      @unique @map("report_id")
  // DINOv2 ViT-B/14 output. Escrito por el Backend IA, consumido por el Backend
  // Principal para el matching por similitud (distancia coseno de pgvector,
  // operador `<=>`, que es el que usa el indice HNSW vector_cosine_ops).
  embedding Unsupported("vector(768)")
  createdAt DateTime @default(now()) @map("created_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("report_embeddings")
}

// denuncia de una cuenta con gravedad (#267); a las 5 se calcula la sanción (#38)
enum AccountReportSeverity {
  mild
  moderate
  severe

  @@map("account_report_severity")
}

model AccountReport {
  id             Int                   @id @default(autoincrement())
  reportedUserId Int                   @map("reported_user_id")
  reporterId     Int                   @map("reporter_id")
  severity       AccountReportSeverity
  sanctionId     Int?                  @map("sanction_id")
  createdAt      DateTime              @default(now()) @map("created_at")

  reportedUser User             @relation("AccountReportReported", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reporter     User             @relation("AccountReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  sanction     AccountSanction? @relation(fields: [sanctionId], references: [id], onDelete: Cascade)

  // una denuncia por persona y ciclo: índice único parcial (sanction_id IS NULL) en SQL crudo
  @@index([reportedUserId, sanctionId])
  @@map("account_reports")
}

enum AccountSanctionKind {
  temporary
  provisional
  permanent

  @@map("account_sanction_kind")
}

enum AccountSanctionStatus {
  active
  pending_review
  expired
  reverted
  dismissed

  @@map("account_sanction_status")
}

enum AccountSanctionEventType {
  created
  confirmed
  reverted
  dismissed
  expired

  @@map("account_sanction_event_type")
}

// sanción de cuenta (#38); única fuente de verdad del estado de suspensión
model AccountSanction {
  id                  Int                   @id @default(autoincrement())
  userId              Int                   @map("user_id")
  severity            AccountReportSeverity
  kind                AccountSanctionKind
  status              AccountSanctionStatus
  warning             Boolean               @default(false)
  reason              String
  triggeringReportIds Int[]                 @map("triggering_report_ids")
  startsAt            DateTime              @map("starts_at")
  endsAt              DateTime?             @map("ends_at")
  createdAt           DateTime              @default(now()) @map("created_at")

  user    User                   @relation("SanctionTarget", fields: [userId], references: [id], onDelete: Cascade)
  reports AccountReport[]
  events  AccountSanctionEvent[]

  // índice único parcial "una sanción abierta por usuario" en SQL crudo
  @@index([userId, status])
  @@index([status, endsAt])
  @@map("account_sanctions")
}

// historial append-only; actorId null = sistema
model AccountSanctionEvent {
  id         Int                      @id @default(autoincrement())
  sanctionId Int                      @map("sanction_id")
  actorId    Int?                     @map("actor_id")
  type       AccountSanctionEventType
  reason     String?
  createdAt  DateTime                 @default(now()) @map("created_at")

  sanction AccountSanction @relation(fields: [sanctionId], references: [id], onDelete: Cascade)
  // SetNull: si se elimina la cuenta del staff, el historial queda sin actor
  actor    User?           @relation("SanctionActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([sanctionId])
  @@map("account_sanction_events")
}

enum MatchStatus {
  pending
  confirmed
  rejected

  @@map("match_status")
}

model ReportMatch {
  id              Int         @id @default(autoincrement())
  reportLostId    Int         @map("report_lost_id")
  reportFoundId   Int         @map("report_found_id")
  similarityScore Float?      @map("similarity_score")
  status          MatchStatus @default(pending)
  createdAt       DateTime    @default(now()) @map("created_at")
  confirmedAt     DateTime?   @map("confirmed_at")

  reportLost  Report @relation("MatchLost", fields: [reportLostId], references: [id], onDelete: Cascade)
  reportFound Report @relation("MatchFound", fields: [reportFoundId], references: [id], onDelete: Cascade)

  @@unique([reportLostId, reportFoundId])
  @@index([reportFoundId])
  @@index([status])
  @@map("report_matches")
}

model Chat {
  id        Int      @id @default(autoincrement())
  userAId   Int      @map("user_a_id")
  userBId   Int      @map("user_b_id")
  reportId  Int?     @map("report_id")
  createdAt DateTime @default(now()) @map("created_at")

  userA    User      @relation("ChatUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User      @relation("ChatUserB", fields: [userBId], references: [id], onDelete: Cascade)
  report   Report?   @relation(fields: [reportId], references: [id])
  messages Message[]

  // El chat es POR REPORTE: el mismo par de usuarios puede tener un chat por
  // cada reporte. El par se guarda normalizado (userAId = id menor, userBId =
  // id mayor), así (A,B) y (B,A) caen en la misma fila y la creación
  // concurrente no duplica chats (ver chats.service.ts#createChat).
  // reportId es nullable (ON DELETE SET NULL): Postgres trata los NULL como
  // distintos, así que los chats huérfanos de un reporte borrado no chocan.
  @@unique([userAId, userBId, reportId])
  @@map("chats")
}

model Message {
  id        Int      @id @default(autoincrement())
  chatId    Int      @map("chat_id")
  senderId  Int      @map("sender_id")
  content   String?
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  type      String? // match_suggested | message | report_status_change | nearby_report | role_change
  title     String?
  message   String?
  reportId  Int?     @map("report_id")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  report Report? @relation(fields: [reportId], references: [id])

  @@index([userId])
  @@map("notifications")
}

// historial append-only de cambios de rol (#224)
model RoleChangeAudit {
  id           Int      @id @default(autoincrement())
  // null: la cuenta del admin que hizo el cambio fue eliminada (#38)
  actorId      Int?     @map("actor_id")
  targetId     Int      @map("target_id")
  previousRole Role     @map("previous_role")
  newRole      Role     @map("new_role")
  createdAt    DateTime @default(now()) @map("created_at")

  actor  User? @relation("RoleChangeActor", fields: [actorId], references: [id], onDelete: SetNull)
  target User  @relation("RoleChangeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("role_change_audits")
}

enum LocationConsentStatus {
  accepted
  declined

  @@map("location_consent_status")
}

enum NearbyReportFilter {
  lost
  found
  both

  @@map("nearby_report_filter")
}

// Preferencias de notificación y ubicación del usuario (1:1 con users). Sin
// fila = valores por defecto. `locationConsentStatus` null = todavía no se le
// mostró el modal; `declined` también cubre la revocación.
model NotificationPreference {
  userId             Int                 @id @map("user_id")
  notifyMatch        Boolean             @default(true) @map("notify_match")
  notifyMessage      Boolean             @default(true) @map("notify_message")
  notifyStatusChange Boolean             @default(true) @map("notify_status_change")
  notifyNearby       Boolean             @default(true) @map("notify_nearby")
  nearbyRadiusKm     Int                 @default(5) @map("nearby_radius_km")
  nearbyReportType   NearbyReportFilter  @default(both) @map("nearby_report_type")
  locationConsentStatus LocationConsentStatus? @map("location_consent_status")
  locationConsentAt  DateTime?           @map("location_consent_at")
  // Última ubicación detectada (PostGIS, como reports.location). Se maneja con
  // SQL crudo (ST_DWithin).
  location           Unsupported("geometry(Point, 4326)")?
  locationUpdatedAt  DateTime?           @map("location_updated_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

enum BusinessCategory {
  VETERINARIA
  REFUGIO
  PET_SHOP
  OTRO

  @@map("business_category")
}

// Un único plan pago (ADR-0024)
enum BusinessPlan {
  FREE
  PREMIUM

  @@map("business_plan")
}

enum SubscriptionPeriod {
  MONTHLY
  ANNUAL

  @@map("subscription_period")
}

enum SubscriptionStatus {
  APPROVED
  REJECTED

  @@map("subscription_status")
}

// Compras del plan Premium; `provider` = "fake" mientras no haya pasarela real.
// Período null en las rechazadas.
model Subscription {
  id          Int                @id @default(autoincrement())
  businessId  Int                @map("business_id")
  period      SubscriptionPeriod
  amountUsd   Decimal            @map("amount_usd") @db.Decimal(10, 2)
  provider    String
  reference   String
  status      SubscriptionStatus
  periodStart DateTime?          @map("period_start")
  periodEnd   DateTime?          @map("period_end")
  createdAt   DateTime           @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("subscriptions")
}

model Business {
  id            Int              @id @default(autoincrement())
  userId        Int              @unique @map("user_id")
  name          String
  cuit          String           @unique
  address       String
  phone         String
  category      BusinessCategory
  // pin del mapa (#208); null en comercios previos
  latitude      Float?
  longitude     Float?
  // perfil público (ADR-0024)
  description   String?
  website       String?
  socialLinks   String[]         @default([]) @map("social_links")
  plan          BusinessPlan     @default(FREE)
  planExpiresAt DateTime?        @map("plan_expires_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events        BusinessEvent[]
  subscriptions Subscription[]
  ads           Ad[]

  @@map("businesses")
}

// ACTIVE/PAUSED los maneja el dueño; REMOVED = baja por moderación.
// Con el Premium vencido un ACTIVE no se muestra, pero no cambia de estado (ADR-0024).
enum AdStatus {
  ACTIVE
  PAUSED
  REMOVED

  @@map("ad_status")
}

model Ad {
  id         Int      @id @default(autoincrement())
  businessId Int      @map("business_id")
  title      String
  body       String
  imageUrl   String   @map("image_url")
  radiusKm   Int      @map("radius_km")
  status     AdStatus @default(ACTIVE)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  events   AdEvent[]
  flags    AdFlag[]

  @@index([businessId, status])
  @@map("ads")
}

// removed = el moderador dio de baja el anuncio; dismissed = denuncia desestimada
enum AdFlagStatus {
  pending
  removed
  dismissed

  @@map("ad_flag_status")
}

// Denuncia de un usuario sobre un anuncio (moderación posterior, ADR-0024)
model AdFlag {
  id        Int          @id @default(autoincrement())
  adId      Int          @map("ad_id")
  userId    Int          @map("user_id")
  reason    String
  status    AdFlagStatus @default(pending)
  createdAt DateTime     @default(now()) @map("created_at")

  ad   Ad   @relation(fields: [adId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([adId, userId])
  @@index([status])
  @@map("ad_flags")
}

enum AdEventType {
  impression
  click

  @@map("ad_event_type")
}

// ubicaciones de la plataforma con banner
enum AdPlacement {
  feed
  report_detail

  @@map("ad_placement")
}

// Métricas de campaña. Sin usuario ni coordenadas: el comercio solo ve totales (ADR-0024)
model AdEvent {
  id        Int         @id @default(autoincrement())
  adId      Int         @map("ad_id")
  type      AdEventType
  placement AdPlacement
  createdAt DateTime    @default(now()) @map("created_at")

  ad Ad @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId, createdAt])
  @@map("ad_events")
}

enum BusinessEventType {
  VIEW
  CONTACT

  @@map("business_event_type")
}

// Log append-only de interacciones con el perfil publico de un comercio.
// Es la fuente de verdad de las metricas del dashboard (`getStats`): cada fila
// es un evento real y persistido, nunca un valor calculado o estimado.
model BusinessEvent {
  id         Int               @id @default(autoincrement())
  businessId Int               @map("business_id")
  type       BusinessEventType
  // null = visitante anonimo (sin sesion iniciada)
  userId     Int?              @map("user_id")
  createdAt  DateTime          @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, type])
  @@map("business_events")
}
