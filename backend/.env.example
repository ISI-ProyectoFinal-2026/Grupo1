# Backend Principal — copiar a `.env` (no versionado) y ajustar.
#
#   cp .env.example .env

# El puerto es 5433 en el host, no 5432: ver docker/ENV_VARS.md.
DATABASE_URL=postgresql://patitas:patitas@localhost:5433/patitas
NODE_ENV=development
PORT=3001

# Origen permitido por CORS.
FRONTEND_URL=http://localhost:5173

# Firma de los JWT. En desarrollo cualquier string sirve; en un entorno
# desplegado usa un valor largo y generado al azar, y no lo commitees.
JWT_SECRET=dev-jwt-secret
JWT_EXPIRY=7d

# Backend IA (matching por similitud, issue #18). Si no esta seteada, el
# trigger de generacion de embedding no hace nada: el reporte se crea igual
# pero nunca genera embedding ni matches.
AI_SERVICE_URL=http://localhost:8000

# Clave compartida para la comunicacion server-to-server con el Backend IA.
# TIENE que ser el mismo valor que INTERNAL_API_KEY en backend-ia/.env.
#
# Se usa en las dos direcciones:
#   - Node -> Backend IA: se manda en el header X-Internal-Key.
#   - Backend IA -> Node: valida POST /api/notifications/internal/match.
#
# Si falta o no coincide, el Backend IA responde 401 y los reportes con
# imagen se quedan en pending (ver issue #106).
INTERNAL_API_KEY=dev-internal-key

# Cloudflare R2, para el upload de imagenes de los reportes. Si faltan,
# POST /api/uploads/presign responde 503 diciendo cual falta.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
