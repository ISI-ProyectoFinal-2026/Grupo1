# Clave compartida con el backend principal: debe tener el mismo valor que INTERNAL_API_KEY en backend/.env.
# Protege /images/analyze y /images/embedding (header X-Internal-Key).
INTERNAL_API_KEY=

# Solo para desarrollo local: true permite arrancar sin INTERNAL_API_KEY y atender /images/* sin autenticar.
# Nunca en un entorno desplegado.
ALLOW_INSECURE_INTERNAL=false