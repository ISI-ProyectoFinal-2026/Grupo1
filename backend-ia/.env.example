# Backend IA — copiar a `.env` (no versionado) y ajustar.
#
#   cp .env.example .env

# Misma base que el Backend Principal. El puerto es 5433 en el host, no 5432:
# ver docker/ENV_VARS.md.
DATABASE_URL=postgresql+asyncpg://patitas:patitas@localhost:5433/patitas

# Clave compartida para la comunicacion server-to-server con el Backend
# Principal. TIENE que ser el mismo valor que INTERNAL_API_KEY en
# backend/.env, si no el Backend IA responde 401 y los reportes con imagen
# se quedan en pending.
#
# Sin esta variable, POST /reports/{id}/embedding rechaza TODO con 401
# (falla cerrado a proposito, ver issue #106). Para desarrollo local podes
# poner cualquier string; en un entorno desplegado usa un valor generado al
# azar y no lo commitees.
INTERNAL_API_KEY=dev-internal-key

# URL del Backend Principal, para avisarle cuando se persiste un match y
# dispare las notificaciones. Si esta vacia, el matching funciona igual pero
# nadie recibe la notificacion.
NODE_BACKEND_URL=http://localhost:3001

# Escotilla SOLO para desarrollo local: permite atender el endpoint de
# embeddings sin INTERNAL_API_KEY configurada. Dejar comentada salvo que
# sepas exactamente por que la necesitas. NUNCA en un entorno desplegado.
# ALLOW_INSECURE_INTERNAL=true

# Loguea todo el SQL que emite SQLAlchemy. Util para depurar, muy ruidoso.
# SQL_ECHO=true
