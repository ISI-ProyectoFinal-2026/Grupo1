# Servicio de backup — copiar a `backup/.env` (no versionado) y completar.
# Ver docs/BACKUP.md.
#
#   cp backup/.env.example backup/.env
#
# DATABASE_URL y BACKUP_DIR los fija docker-compose.yml para el contenedor
# (postgres:5432 y /backups). Solo hace falta definirlos al correr fuera de Docker.
# DATABASE_URL=postgresql://patitas:patitas@localhost:5433/patitas
# BACKUP_DIR=../patitas-backups

# Endpoint S3 de la cuenta de Cloudflare R2.
BACKUP_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Token de API de R2 con lectura y escritura sobre los DOS buckets:
# el de backup y el de imágenes (origen de la copia).
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=

# Bucket exclusivo para backups (distinto del de imágenes).
BACKUP_R2_BUCKET=patitas-backups

# Bucket de imágenes de la app (mismo valor que R2_BUCKET_NAME del backend).
SOURCE_IMAGES_BUCKET=

# Hora local diaria del backup (0-23) y zona horaria del contenedor.
BACKUP_HOUR=3
TZ=America/Argentina/Buenos_Aires
