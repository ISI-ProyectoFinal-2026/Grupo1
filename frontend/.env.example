# Frontend Environment Variables

# API Base URL (Backend Express)
VITE_API_URL=http://localhost:3000/api

# Socket.io URL (Real-time chat)
VITE_SOCKET_URL=http://localhost:3000

# Cloudflare R2 (Image uploads)
VITE_R2_BUCKET_URL=https://your-bucket.your-account.r2.cloudflarestorage.com
VITE_R2_PUBLIC_URL=https://your-public-url.com

# Feature flags (optional)
VITE_ENABLE_CHAT=true
VITE_ENABLE_COMERCIOS=true
VITE_ENABLE_IA_MATCHING=true

# Analytics (optional)
# VITE_ANALYTICS_ID=your-analytics-id
