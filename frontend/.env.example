# Frontend Environment Variables
#
# El frontend NO necesita ninguna variable para correr en desarrollo.
#
# Las llamadas salen a la ruta relativa `/api` (ver src/services/api.ts) y
# vite.config.ts las proxea al backend Express en http://localhost:3001.
# Al ir por el proxy el navegador ve todo como same-origin: no hay CORS que
# configurar del lado del front.
#
# Si cambias el puerto del backend (backend/.env -> PORT), actualiza el
# target del proxy en vite.config.ts, no este archivo.

# Socket.io URL (chat en tiempo real, issue #126).
# Todavia no se consume desde src/. Cuando se conecte, apunta al mismo puerto
# del backend Express, que es donde se monta Socket.io.
VITE_SOCKET_URL=http://localhost:3001

# NOTA sobre Cloudflare R2:
# El frontend nunca habla directo con R2 usando credenciales. El flujo es
#   1. POST /api/uploads/presign  -> el backend firma la URL
#   2. PUT a esa URL firmada      -> sube el archivo
#   3. el backend devuelve publicUrl -> se usa en el body del reporte
# Las credenciales y el dominio publico del bucket viven en backend/.env
# (R2_ENDPOINT, R2_BUCKET_NAME, R2_PUBLIC_URL, R2_ACCESS_KEY_ID,
# R2_SECRET_ACCESS_KEY). No agregues nada de R2 aca: todo lo que empieza con
# VITE_ queda embebido en el bundle y es publico.
